{
  "headers": [
    {
      "source": "/basic_data/performance-static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/basic_data/assets/strategy-lookthrough/model-bundles/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    }
  ],
  "buildCommand": "PRIVATE_FUND_EDGEONE_BUILD=1 node scripts/prepare_edgeone_static.cjs",
  "outputDirectory": "_edgeone_static"
}
